{
  "MongoSettings": {
    "ConnectionString": "mongodb://db/",
    "Database": "SlipkaDb",
    "ChunkSizeBytes": 1048576
  },
  "RedisSettings": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "slipka",
    "DefaultDatabase": 0,
    "Enabled": true
  },
  "ProxySettings": {
    "FirstPort": 61710,
    "LastPort": 61920,
    "DefaultOpenFor": "01:00:00",
    "MaxOpenFor": "2:00:00:00",
    "DefaultRetainedFor": "31:00:00:00",
    "MaxRetainedFor": "90:00:00:00",
    "GridFsCleanupLoop": 50000,
    "ProxyPersistanceLoop": 5000
  },
  "StaticProxies": {
    "Proxies": [
      {
        "Id": "production-mirror",
        "Port": 61800,
        "TargetHost": "api.production.com",
        "TargetPort": 443,
        "Name": "Production API Mirror",
        "AutoStart": true,
        "RecordedCalls": [
          {
            "Method": "POST",
            "Uri": "/api/orders",
            "Tags": [ "production-order" ]
          }
        ],
        "Decorations": [
          {
            "Key": "X-Proxy-Source",
            "Values": [ "slipka-production-mirror" ]
          }
        ]
      },
      {
        "Id": "ipapi-proxy",
        "Port": 61710,
        "TargetHost": "ipapi.co",
        "TargetPort": 443,
        "TargetPortHttps": true,
        "ProxyPortHttps": false,
        "Name": "IP API Geolocation Proxy",
        "AutoStart": true,
        "Decorations": [
          {
            "Key": "X-Proxy-Source",
            "Values": [ "slipka-ipapi-proxy" ]
          }
        ]
      },
      {
        "Id": "ipapi2-proxy",
        "Port": 61711,
        "TargetHost": "ipapi.co",
        "TargetPort": 443,
        "TargetPortHttps": true,
        "ProxyPortHttps": true,
        "Name": "IP API Geolocation Proxy 2",
        "AutoStart": true,
        "Decorations": [
          {
            "Key": "X-Proxy-Source",
            "Values": [ "slipka-ipapi2-proxy" ]
          }
        ]
      },
      {
        "Id": "staging-simulator",
        "Port": 61801,
        "TargetHost": "api.staging.com",
        "TargetPort": 80,
        "Name": "Staging Error Simulator",
        "AutoStart": false,
        "InjectedCalls": [
          {
            "Method": "GET",
            "Uri": "/api/health",
            "StatusCode": "503",
            "Duration": 1000,
            "Response": {
              "Content": "{\"status\": \"Service Unavailable\", \"message\": \"Simulated outage\"}",
              "Headers": [
                {
                  "Key": "Content-Type",
                  "Values": [ "application/json" ]
                }
              ]
            },
            "Tags": [ "error-simulation" ]
          }
        ]
      }
    ]
  },
  "Logging": {
    "IncludeScopes": false,
    "Debug": {
      "LogLevel": {
        "Default": "Warning"
      }
    },
    "Console": {
      "LogLevel": {
        "Default": "Warning"
      }
    }
  }
}
